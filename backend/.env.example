
# --- Security (required) ---
# Long random string (32+ chars). Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET= 
# How long a login lasts (default 3d)
JWT_EXPIRES_IN=3d

# --- Database (use the limited user from migration_limited_db_user.sql) ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=
PGUSER=resource_app
PGPASSWORD=
# DATABASE_URL=postgres://user:password@host:5432/dbname   (alternative to the PG* values)

# --- Email (OTP mails) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Deployment ---
# Set to production on the live server (also run `npm run build` in frontend/ first)
NODE_ENV=production
# Only if the frontend is hosted on a different address than this server (comma-separated)
CLIENT_ORIGIN=
# Set to 1 when the server sits behind a proxy (nginx / hosting platform); leave empty locally
TRUST_PROXY=